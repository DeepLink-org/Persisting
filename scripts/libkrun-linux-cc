#!/bin/sh
set -eu

host_os=$(uname -s)
host_arch=$(uname -m)

case "$host_os" in
    Linux)
        exec cc "$@"
        ;;
    Darwin)
        case "$host_arch" in
            arm64 | aarch64)
                linux_target=aarch64-linux-musl
                ;;
            x86_64 | amd64)
                linux_target=x86_64-linux-musl
                ;;
            *)
                echo "unsupported macOS architecture for libkrun guest init: $host_arch" >&2
                exit 1
                ;;
        esac
        if ! command -v zig >/dev/null 2>&1; then
            echo "Zig is required to compile libkrun's Linux guest init on macOS; install it with: brew install zig" >&2
            exit 127
        fi
        exec zig cc -target "$linux_target" "$@"
        ;;
    *)
        echo "unsupported host for libkrun guest init: $host_os/$host_arch" >&2
        exit 1
        ;;
esac
